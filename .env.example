# Optional settings for qeep revival.
# Copy this file to .env (or set these in your host's dashboard).

# Port to listen on (hosts like Render set this for you).
PORT=8080

# Persist profiles, coins, friends and messages to Postgres instead of a local file.
# Works with any Postgres, including free tiers from Neon, Supabase or Render.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
